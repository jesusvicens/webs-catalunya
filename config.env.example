# Copia este archivo como config.env y rellena tus datos.

# --- Búsqueda de negocios (https://outscraper.com → Profile → API key) ---
OUTSCRAPER_API_KEY=

# --- Publicación de demos (https://app.netlify.com → User settings → Applications → Personal access token) ---
NETLIFY_TOKEN=
NETLIFY_SITE_ID=
# URL pública de ese sitio de Netlify, sin barra final (gratis: no hace falta dominio propio)
DEMO_BASE_URL=https://websosona.netlify.app

# --- Envío de emails ---
# Cuenta de envío: Gmail gratuito dedicado. Activa la verificación en 2 pasos y crea una
# "contraseña de aplicación" en myaccount.google.com/apppasswords (16 letras) → EMAIL_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
EMAIL_USER=webscatalunya@gmail.com
EMAIL_PASS=
# Còpia oculta de tot el que s'envia al Gmail on Claude gestiona les respostes
BCC_COPIA=jesusvicens8@gmail.com
# Pont de respostes (7_relay.py): només s'accepten ordres d'aquest remitent i amb aquest token
RELAY_REMITENT=jesusvicens8@gmail.com
RELAY_TOKEN=4a76fdac38d6
REMITENTE_NOMBRE=Jesús
REMITENTE_FIRMA=Jesús · Webs per a negocis d'Osona

# --- Oferta (aparece en el email) ---
PRECIO_UNICO=390
PRECIO_MES=29

# --- Ritmo de envío ---
MAX_ENVIOS_DIA=12
PAUSA_MIN_SEG=120
PAUSA_MAX_SEG=360
HORA_INICIO=9
HORA_FIN=18
# Días tras el primer email para cada seguimiento
SEGUIMIENTOS_DIAS=4,10

# --- Cobraments (Stripe) ---
# Clau restringida amb permís de LECTURA de Checkout Sessions (Developers → API keys → Create restricted key)
STRIPE_SECRET_KEY=
# Enllaç de pagament (Payment Link) amb 390 € únic + 29 €/mes
PAYMENT_LINK_URL=
